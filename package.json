{
  "name": "rizhi",
  "version": "0.3.0",
  "description": "日织 - 工作、学习与生活平衡管理桌面客户端",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LouDev1c/rizhi-pc.git"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check src/renderer.js && node --check src/parsers/scheduleParser.js && node --check src/parsers/textScheduleParser.js && node --check src/storage/localDataStore.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.rizhi.pc",
    "productName": "日织",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LouDev1c",
        "repo": "rizhi-pc"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "rizhi.ico",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "rizhi.ico",
        "to": "rizhi.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "rizhi.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "日织"
    }
  },
  "keywords": [
    "RiZhi",
    "schedule",
    "health",
    "reminder"
  ],
  "devDependencies": {
    "electron": "44.1.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
